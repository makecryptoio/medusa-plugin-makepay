{
  "compilerOptions": {
    "declaration": true,
    "declarationMap": false,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM"],
    "module": "Node16",
    "moduleResolution": "Node16",
    "newLine": "lf",
    "outDir": ".medusa/server",
    "rootDir": ".",
    "skipLibCheck": true,
    "sourceMap": false,
    "strict": true,
    "target": "ES2022",
    "types": ["node"]
  },
  "ts-node": {
    "swc": true
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts"],
  "exclude": [".medusa", "node_modules", "src/admin"]
}
